{
  "name": "davidlescano.com",
  "version": "0.1.0",
  "private": true,
  "description": "Personal website of David Lescano, Full-Stack Software Engineer in Munich.",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "predev": "node scripts/check-node.mjs",
    "dev": "next dev",
    "dev:drafts": "NEXT_PUBLIC_SHOW_DRAFTS=true next dev",
    "prebuild": "node scripts/check-node.mjs",
    "build": "next build",
    "prestart": "node scripts/check-node.mjs",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build"
  },
  "dependencies": {
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "geist": "1.9.2",
    "lucide-react": "1.70.0",
    "next": "16.4.5",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.5",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "fsevents": false
  }
}
